import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Principles">
<header class="editorial-hero editorial-hero--principles"><div class="kicker">principles</div><h1>The Working Creed</h1><p>Conviction, restraint, and the obligation to question power.</p></header>

  <main class="prose reading">
    <blockquote>We question power. We refuse ideological capture. We resist moral amnesia. We protect what deserves to endure. We name what others hesitate to say.</blockquote>
    <p>These are not slogans. They are constraints. The work here should remain serious enough to criticize every tribe, restrained enough to avoid spectacle, and honest enough to admit complexity when complexity is real.</p>
  </main>
</BaseLayout>
