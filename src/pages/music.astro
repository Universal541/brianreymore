---
import BaseLayout from '../layouts/BaseLayout.astro';
const tracks = [
  {
    "title": "Minutes of Love",
    "src": "/audio/01-minutes-of-love.mp3",
    "duration": 404,
    "number": 1
  },
  {
    "title": "One Foot Home",
    "src": "/audio/02-one-foot-home.mp3?v=20261020-fix1",
    "duration": 433,
    "number": 2
  },
  {
    "title": "The Broadacres Rag (Traumatic Character Limit Mix)",
    "src": "/audio/03-the-broadacres-rag-traumatic-character-limit-mix.mp3",
    "duration": 335,
    "number": 3
  },
  {
    "title": "The Fire Never Died",
    "src": "/audio/04-the-fire-never-died.mp3",
    "duration": 328,
    "number": 4
  },
  {
    "title": "Never Been This Old",
    "src": "/audio/05-never-been-this-old.mp3",
    "duration": 314,
    "number": 5
  },
  {
    "title": "Flight of the Queen Bee",
    "src": "/audio/06-flight-of-the-queen-bee.mp3",
    "duration": 322,
    "number": 6
  },
  {
    "title": "You Radiate Love",
    "src": "/audio/07-you-radiate-love.mp3",
    "duration": 408,
    "number": 7
  },
  {
    "title": "Prison Break",
    "src": "/audio/08-prison-break.mp3",
    "duration": 432,
    "number": 8
  },
  {
    "title": "Swiped Right",
    "src": "/audio/09-swiped-right.mp3",
    "duration": 312,
    "number": 9
  },
  {
    "title": "Minutes of Love (feat. Grubby)",
    "src": "/audio/10-minutes-of-love-feat-grubby.mp3",
    "duration": 389,
    "number": 10
  },
  {
    "title": "The Last Ride",
    "src": "/audio/11-the-last-ride.mp3",
    "duration": 314,
    "number": 11
  },
  {
    "title": "The Broadacres Rag",
    "src": "/audio/12-the-broadacres-rag.mp3",
    "duration": 365,
    "number": 12
  },
  {
    "title": "What Truth Requires",
    "src": "/audio/13-what-truth-requires.mp3",
    "duration": 360,
    "number": 13
  }
];
const formatDuration = (seconds) => `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
---
<BaseLayout title="Music" description="Listen to thirteen original songs by Brian “Bugsy” McRae.">
<main>
<header class="editorial-hero editorial-hero--music"><div class="kicker">Brian “Bugsy” McRae</div><h1>Music</h1><p>Some things are better sung than explained.</p></header>
<section class="container music-room" aria-label="Bugsy McRae listening room">
<div class="music-room-heading"><div><div class="kicker">The listening room</div><h2>Bugsy McRae</h2><p>Thirteen songs. One road, a thousand stories.</p></div><div class="music-count">13 TRACKS · ORIGINAL RECORDINGS</div></div>
<div class="music-player" data-music-player>
<div class="music-now"><div class="music-art" aria-hidden="true">BM</div><div class="music-current"><div class="kicker">Now playing</div><h3 id="now-title">Minutes of Love</h3><p>Bugsy McRae</p></div></div>
<audio id="music-audio" preload="metadata"></audio>
<div class="music-controls"><button type="button" id="music-prev" aria-label="Previous track">⏮</button><button type="button" id="music-toggle" aria-label="Play" class="music-play">▶</button><button type="button" id="music-next" aria-label="Next track">⏭</button><div class="music-timeline"><span id="music-elapsed">0:00</span><input id="music-seek" type="range" min="0" max="1000" value="0" aria-label="Seek through track"/><span id="music-total">6:44</span></div><label class="music-volume">Volume <input id="music-volume" type="range" min="0" max="100" value="85" aria-label="Volume"/></label></div>
<p class="music-status" id="music-status" role="status" aria-live="polite"></p>
<section class="lyrics" aria-label="Song lyrics">
<div class="lyrics-head"><div><div class="kicker">Words behind the music</div><h4>Lyrics</h4></div><button type="button" id="lyrics-toggle" aria-controls="lyrics-panel" aria-expanded="false">Show lyrics</button></div>
<div id="lyrics-panel" hidden><div class="lyrics-tools"><span id="lyrics-title"></span><div><button id="lyrics-auto" type="button" disabled aria-pressed="false">Auto-scroll</button><button id="lyrics-minus" type="button" aria-label="Decrease lyrics size">A−</button><button id="lyrics-plus" type="button" aria-label="Increase lyrics size">A+</button></div></div>
<div id="lyrics-scroll" tabindex="0" role="region" aria-label="Scrollable lyrics"><div id="lyrics-content">Lyrics are being prepared for this track.</div></div><p class="lyrics-note" id="lyrics-note">Full lyrics and synchronization will be added track by track.</p></div></section>
</div>
<ol class="music-tracklist" aria-label="Track list">{tracks.map((track,index) => <li><button type="button" class:list={['music-track',{'is-active':index===0}]} data-track-index={index} aria-label={`Play ${track.title}`}><span class="music-track-number">{String(track.number).padStart(2,'0')}</span><span class="music-track-title">{track.title}</span><span class="music-track-duration">{formatDuration(track.duration)}</span><span class="music-track-action" aria-hidden="true">▶</span></button></li>)}</ol>
<p class="music-credit">All tracks presented in the artist's chosen sequence, independent of embedded MP3 track metadata. Artist: Brian “Bugsy” McRae.</p>
</section>
</main>
<script is:inline>
(() => {
const tracks = [{"title":"Minutes of Love","src":"/audio/01-minutes-of-love.mp3","duration":404},{"title":"One Foot Home","src":"/audio/02-one-foot-home.mp3?v=20261020-fix1","duration":433},{"title":"The Broadacres Rag (Traumatic Character Limit Mix)","src":"/audio/03-the-broadacres-rag-traumatic-character-limit-mix.mp3","duration":335},{"title":"The Fire Never Died","src":"/audio/04-the-fire-never-died.mp3","duration":328},{"title":"Never Been This Old","src":"/audio/05-never-been-this-old.mp3","duration":314},{"title":"Flight of the Queen Bee","src":"/audio/06-flight-of-the-queen-bee.mp3","duration":322},{"title":"You Radiate Love","src":"/audio/07-you-radiate-love.mp3","duration":408},{"title":"Prison Break","src":"/audio/08-prison-break.mp3","duration":432},{"title":"Swiped Right","src":"/audio/09-swiped-right.mp3","duration":312},{"title":"Minutes of Love (feat. Grubby)","src":"/audio/10-minutes-of-love-feat-grubby.mp3","duration":389},{"title":"The Last Ride","src":"/audio/11-the-last-ride.mp3","duration":314},{"title":"The Broadacres Rag","src":"/audio/12-the-broadacres-rag.mp3","duration":365},{"title":"What Truth Requires","src":"/audio/13-what-truth-requires.mp3","duration":360}];
const audio = document.getElementById('music-audio');
const title = document.getElementById('now-title');
const toggle = document.getElementById('music-toggle');
const prev = document.getElementById('music-prev');
const next = document.getElementById('music-next');
const seek = document.getElementById('music-seek');
const elapsed = document.getElementById('music-elapsed');
const total = document.getElementById('music-total');
const volume = document.getElementById('music-volume');
const status = document.getElementById('music-status');
const buttons = [...document.querySelectorAll('[data-track-index]')];
let index = 0;
const lyricToggle=document.getElementById('lyrics-toggle'),lyricPanel=document.getElementById('lyrics-panel'),lyricContent=document.getElementById('lyrics-content'),lyricScroll=document.getElementById('lyrics-scroll'),lyricTitle=document.getElementById('lyrics-title'),lyricAuto=document.getElementById('lyrics-auto'),lyricNote=document.getElementById('lyrics-note');
const lyricNames=['minutes-of-love','one-foot-home','the-broadacres-rag-traumatic-character-limit-mix','the-fire-never-died','never-been-this-old','flight-of-the-queen-bee','prison-break','swiped-right','minutes-of-love-feat-grubby','the-last-ride','the-broadacres-rag','what-truth-requires'];
let lyricCues=[],lyricSync=false,lyricRequest=0,lyricFont=1.15;
lyricToggle.addEventListener('click',()=>{lyricPanel.hidden=!lyricPanel.hidden;lyricToggle.textContent=lyricPanel.hidden?'Show lyrics':'Hide lyrics';lyricToggle.setAttribute('aria-expanded',String(!lyricPanel.hidden));});
lyricAuto.addEventListener('click',()=>{lyricSync=!lyricSync;lyricAuto.setAttribute('aria-pressed',String(lyricSync));syncLyrics();});
lyricScroll.addEventListener('wheel',()=>{lyricSync=false;lyricAuto.setAttribute('aria-pressed','false');},{passive:true});
for(const [name,step] of [['lyrics-minus',-.1],['lyrics-plus',.1]])document.getElementById(name).addEventListener('click',()=>{lyricFont=Math.max(.9,Math.min(1.8,lyricFont+step));lyricScroll.style.fontSize=lyricFont+'rem';});
async function loadLyrics(i){
 const req=++lyricRequest;lyricCues=[];lyricSync=false;lyricAuto.disabled=true;lyricAuto.setAttribute('aria-pressed','false');
 lyricTitle.textContent=tracks[i].title;lyricContent.textContent='Lyrics are being prepared for this track.';lyricNote.textContent='Full lyrics and synchronization will be added track by track.';lyricScroll.scrollTop=0;
 try{
  const response=await fetch('/lyrics/'+lyricNames[i]+'.json');if(!response.ok)return;
  const data=await response.json();if(req!==lyricRequest||!Array.isArray(data.lines))return;
  const cues=data.lines.map(x=>typeof x==='string'?{text:x}:x).filter(x=>x&&typeof x.text==='string');if(!cues.length)return;
  lyricCues=cues;lyricContent.replaceChildren();
  cues.forEach(cue=>{const p=document.createElement('p');p.className='lyrics-line';p.textContent=cue.text;lyricContent.appendChild(p);});
  const timed=cues.every(x=>typeof x.time==='number'&&Number.isFinite(x.time));lyricAuto.disabled=!timed;
  lyricNote.textContent=timed?'Enable Auto-scroll for timed highlighting, or read at your own pace.':'Scroll manually; timed highlighting will follow when available.';
 }catch(e){/* A missing lyrics file is an expected state. */}
}
function syncLyrics(){
 if(!lyricSync||lyricPanel.hidden||lyricAuto.disabled)return;
 let current=-1;lyricCues.forEach((cue,i)=>{if(audio.currentTime>=cue.time)current=i;});
 [...lyricContent.children].forEach((line,i)=>line.classList.toggle('is-current',i===current));
 if(current>=0){const line=lyricContent.children[current];lyricScroll.scrollTop=line.offsetTop-lyricScroll.offsetTop-lyricScroll.clientHeight/2+line.clientHeight/2;}
}
let activeBlobUrl = null;
let playbackRequest = 0;
let fallbackAttempted = false;
const clock = seconds => Number.isFinite(seconds) ? `${Math.floor(seconds/60)}:${String(Math.floor(seconds%60)).padStart(2,'0')}` : '0:00';
function select(i, autoplay = true) {
 index = (i + tracks.length) % tracks.length;
 const track = tracks[index];
 playbackRequest++;
 fallbackAttempted = false;
 if (activeBlobUrl) { URL.revokeObjectURL(activeBlobUrl); activeBlobUrl = null; }
 audio.src = track.src;
 title.textContent = track.title;
 loadLyrics(index);
 elapsed.textContent = '0:00';
 total.textContent = clock(track.duration);
 seek.value = '0';
 buttons.forEach((button,j) => {button.classList.toggle('is-active',j===index);button.setAttribute('aria-current',j===index?'true':'false');});
 status.textContent = '';
 if (autoplay) play();
 else toggle.textContent = '▶';
}
async function tryDirectDownloadFallback() {
 if (index !== 1 || fallbackAttempted) return false;
 fallbackAttempted = true;
 const request = playbackRequest;
 status.textContent = 'Trying an alternate audio loading method…';
 try {
  // Fetch without an audio element's Range header; reject HTML fallbacks.
  const response = await fetch('/audio/02-one-foot-home.mp3?download=1&v=20261020-fix1', {cache:'no-store'});
  if (!response.ok) throw new Error('HTTP ' + response.status);
  const type = response.headers.get('content-type') || '';
  if (type.includes('text/html')) throw new Error('Server returned HTML instead of audio');
  const blob = await response.blob();
  if (request !== playbackRequest || index !== 1) return true;
  if (blob.size < 100000 || (blob.type && blob.type.includes('text/html'))) throw new Error('Invalid audio response');
  activeBlobUrl = URL.createObjectURL(new Blob([blob], {type:'audio/mpeg'}));
  audio.src = activeBlobUrl;
  await audio.play();
  status.textContent = '';
  return true;
 } catch (error) {
  if (request === playbackRequest && index === 1) status.textContent = 'One Foot Home could not load: ' + error.message;
  return false;
 }
}
async function play(){
 const request = playbackRequest;
 try { await audio.play(); if(request !== playbackRequest)return; toggle.textContent='Ⅱ';toggle.setAttribute('aria-label','Pause');status.textContent=''; }
 catch(error){
  if(request !== playbackRequest)return;
  if (await tryDirectDownloadFallback()) return;
  if (!status.textContent || !status.textContent.startsWith('One Foot Home')) status.textContent='Playback failed: ' + (error?.message || 'Unknown browser error');
  toggle.textContent='▶';
 }
}
toggle.addEventListener('click',()=>{if(audio.paused)play();else audio.pause();});
audio.addEventListener('pause',()=>{toggle.textContent='▶';toggle.setAttribute('aria-label','Play');});
audio.addEventListener('play',()=>{toggle.textContent='Ⅱ';toggle.setAttribute('aria-label','Pause');});
audio.addEventListener('timeupdate',()=>{elapsed.textContent=clock(audio.currentTime);if(audio.duration)seek.value=String(Math.round(audio.currentTime/audio.duration*1000));syncLyrics();});
audio.addEventListener('loadedmetadata',()=>{total.textContent=clock(audio.duration);});
audio.addEventListener('ended',()=>select(index+1));
audio.addEventListener('error',()=>{if (index !== 1 || fallbackAttempted) status.textContent='Audio could not be decoded or delivered. Try again.';});
seek.addEventListener('input',()=>{if(audio.duration)audio.currentTime=Number(seek.value)/1000*audio.duration;});
volume.addEventListener('input',()=>audio.volume=Number(volume.value)/100);
prev.addEventListener('click',()=>select(index-1));
next.addEventListener('click',()=>select(index+1));
buttons.forEach((button,i)=>button.addEventListener('click',()=>select(i)));
audio.volume=.85;
select(0,false);
})();
</script>
</BaseLayout>