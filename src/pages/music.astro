---
import BaseLayout from '../layouts/BaseLayout.astro';
const tracks = [
  {
    "title": "Minutes of Love",
    "src": "/audio/01-minutes-of-love.mp3",
    "duration": 404,
    "number": 1
  },
  {
    "title": "One Foot Home",
    "src": "/audio/02-one-foot-home.mp3?v=20261020-fix1",
    "duration": 433,
    "number": 2
  },
  {
    "title": "The Broadacres Rag (Traumatic Character Limit Mix)",
    "src": "/audio/03-the-broadacres-rag-traumatic-character-limit-mix.mp3",
    "duration": 335,
    "number": 3
  },
  {
    "title": "The Fire Never Died",
    "src": "/audio/04-the-fire-never-died.mp3",
    "duration": 328,
    "number": 4
  },
  {
    "title": "Never Been This Old",
    "src": "/audio/05-never-been-this-old.mp3",
    "duration": 314,
    "number": 5
  },
  {
    "title": "Flight of the Queen Bee",
    "src": "/audio/06-flight-of-the-queen-bee.mp3",
    "duration": 322,
    "number": 6
  },
  {
    "title": "You Radiate Love",
    "src": "/audio/07-you-radiate-love.mp3",
    "duration": 408,
    "number": 7
  },
  {
    "title": "Prison Break",
    "src": "/audio/07-prison-break.mp3",
    "duration": 432,
    "number": 8
  },
  {
    "title": "Swiped Right",
    "src": "/audio/08-swiped-right.mp3",
    "duration": 312,
    "number": 9
  },
  {
    "title": "Minutes of Love (feat. Grubby)",
    "src": "/audio/09-minutes-of-love-feat-grubby.mp3",
    "duration": 389,
    "number": 10
  },
  {
    "title": "The Last Ride",
    "src": "/audio/10-the-last-ride.mp3",
    "duration": 314,
    "number": 11
  },
  {
    "title": "The Broadacres Rag",
    "src": "/audio/11-the-broadacres-rag.mp3",
    "duration": 365,
    "number": 12
  },
  {
    "title": "What Truth Requires",
    "src": "/audio/12-what-truth-requires.mp3",
    "duration": 360,
    "number": 13
  }
];
const formatDuration = (seconds) => `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
---
<BaseLayout title="Music" description="Listen to thirteen original songs by Brian “Bugsy” McRae.">
<main>
<header class="editorial-hero editorial-hero--music"><div class="kicker">Brian “Bugsy” McRae</div><h1>Music</h1><p>Some things are better sung than explained.</p></header>
<section class="container music-room" aria-label="Bugsy McRae listening room">
<div class="music-room-heading"><div><div class="kicker">The listening room</div><h2>Bugsy McRae</h2><p>Thirteen songs. One road, a thousand stories.</p></div><div class="music-count">13 TRACKS · ORIGINAL RECORDINGS</div></div>
<div class="music-player" data-music-player>
<div class="music-now"><div class="music-art" aria-hidden="true">BM</div><div class="music-current"><div class="kicker">Now playing</div><h3 id="now-title">Minutes of Love</h3><p>Bugsy McRae</p></div></div>
<audio id="music-audio" preload="metadata"></audio>
<div class="music-controls"><button type="button" id="music-prev" aria-label="Previous track">⏮</button><button type="button" id="music-toggle" aria-label="Play" class="music-play">▶</button><button type="button" id="music-next" aria-label="Next track">⏭</button><div class="music-timeline"><span id="music-elapsed">0:00</span><input id="music-seek" type="range" min="0" max="1000" value="0" aria-label="Seek through track"/><span id="music-total">6:44</span></div><label class="music-volume">Volume <input id="music-volume" type="range" min="0" max="100" value="85" aria-label="Volume"/></label></div>
<p class="music-status" id="music-status" role="status" aria-live="polite"></p>
<section class="lyrics karaoke" aria-label="Synchronized song lyrics">
<div class="karaoke-top"><span class="kicker">Lyrics</span><button type="button" id="lyrics-toggle" aria-controls="lyrics-panel" aria-expanded="true">Hide lyrics</button></div>
<div id="lyrics-panel"><div id="lyrics-scroll" class="karaoke-stage" role="region" aria-label="Live synchronized lyrics" aria-live="off"><div id="lyrics-content" class="karaoke-lines">Loading lyrics…</div></div><p id="lyrics-note" class="karaoke-note" aria-live="polite"></p></div>
</section>
</div>
<ol class="music-tracklist" aria-label="Track list">{tracks.map((track,index) => <li><button type="button" class:list={['music-track',{'is-active':index===0}]} data-track-index={index} aria-label={`Play ${track.title}`}><span class="music-track-number">{String(track.number).padStart(2,'0')}</span><span class="music-track-title">{track.title}</span><span class="music-track-duration">{formatDuration(track.duration)}</span><span class="music-track-action" aria-hidden="true">▶</span></button></li>)}</ol>
<p class="music-credit">All tracks presented in the artist's chosen sequence, independent of embedded MP3 track metadata. Artist: Brian “Bugsy” McRae.</p>
</section>
</main>
<script is:inline>
(() => {
const tracks = [{"title":"Minutes of Love","src":"/audio/01-minutes-of-love.mp3","duration":404},{"title":"One Foot Home","src":"/audio/02-one-foot-home.mp3?v=20261020-fix1","duration":433},{"title":"The Broadacres Rag (Traumatic Character Limit Mix)","src":"/audio/03-the-broadacres-rag-traumatic-character-limit-mix.mp3","duration":335},{"title":"The Fire Never Died","src":"/audio/04-the-fire-never-died.mp3","duration":328},{"title":"Never Been This Old","src":"/audio/05-never-been-this-old.mp3","duration":314},{"title":"Flight of the Queen Bee","src":"/audio/06-flight-of-the-queen-bee.mp3","duration":322},{"title":"You Radiate Love","src":"/audio/07-you-radiate-love.mp3","duration":408},{"title":"Prison Break","src":"/audio/07-prison-break.mp3","duration":432},{"title":"Swiped Right","src":"/audio/08-swiped-right.mp3","duration":312},{"title":"Minutes of Love (feat. Grubby)","src":"/audio/09-minutes-of-love-feat-grubby.mp3","duration":389},{"title":"The Last Ride","src":"/audio/10-the-last-ride.mp3","duration":314},{"title":"The Broadacres Rag","src":"/audio/11-the-broadacres-rag.mp3","duration":365},{"title":"What Truth Requires","src":"/audio/12-what-truth-requires.mp3","duration":360}];
const audio = document.getElementById('music-audio');
const title = document.getElementById('now-title');
const toggle = document.getElementById('music-toggle');
const prev = document.getElementById('music-prev');
const next = document.getElementById('music-next');
const seek = document.getElementById('music-seek');
const elapsed = document.getElementById('music-elapsed');
const total = document.getElementById('music-total');
const volume = document.getElementById('music-volume');
const status = document.getElementById('music-status');
const buttons = [...document.querySelectorAll('[data-track-index]')];
let index = 0;
const lyricToggle=document.getElementById('lyrics-toggle'),lyricPanel=document.getElementById('lyrics-panel'),lyricContent=document.getElementById('lyrics-content'),lyricNote=document.getElementById('lyrics-note');
const lyricNames=['minutes-of-love','one-foot-home','the-broadacres-rag-traumatic-character-limit-mix','the-fire-never-died','never-been-this-old','flight-of-the-queen-bee','you-radiate-love','prison-break','swiped-right','minutes-of-love-feat-grubby','the-last-ride','the-broadacres-rag','what-truth-requires'];
let lyricCues=[],lyricRequest=0,lastLyricIndex=-999;
lyricToggle.addEventListener('click',()=>{lyricPanel.hidden=!lyricPanel.hidden;lyricToggle.textContent=lyricPanel.hidden?'Show lyrics':'Hide lyrics';lyricToggle.setAttribute('aria-expanded',String(!lyricPanel.hidden));if(!lyricPanel.hidden)syncLyrics(true);});
function lyricText(value){
 const t=String(value||'').trim();
 if(!t||/^#{1,6}\\s/.test(t)||/^\\*\\*[^*]+\\*\\*$/.test(t)||/^\\[[^\\]]*\\]$/.test(t))return '';
 return t.replace(/^\\*\\*(.*?)\\*\\*$/,'$1');
}
async function loadLyrics(i){
 const req=++lyricRequest;lyricCues=[];lastLyricIndex=-999;lyricContent.textContent='Loading lyrics…';lyricNote.textContent='';
 try{
  const response=await fetch('/lyrics/'+lyricNames[i]+'.json');if(!response.ok)throw Error('Lyrics unavailable');
  const data=await response.json();if(req!==lyricRequest||!Array.isArray(data.lines))return;
  lyricCues=data.lines.map(x=>typeof x==='string'?{text:x}:x).map(x=>({text:lyricText(x.text),time:x.time})).filter(x=>x.text&&typeof x.time==='number'&&Number.isFinite(x.time)).sort((a,b)=>a.time-b.time);
  if(!lyricCues.length){lyricContent.textContent='Timed lyrics unavailable for this song.';return;}
  syncLyrics(true);
 }catch(e){if(req===lyricRequest)lyricContent.textContent='Lyrics unavailable for this song.';}
}
function syncLyrics(force=false){
 if(lyricPanel.hidden||!lyricCues.length)return;
 let current=-1;for(let i=0;i<lyricCues.length;i++){if(audio.currentTime>=lyricCues[i].time)current=i;else break;}
 if(!force&&current===lastLyricIndex)return;lastLyricIndex=current;
 const fragment=document.createDocumentFragment();
 for(let relative=-1;relative<=1;relative++){
  const cue=lyricCues[current+relative];
  const p=document.createElement('p');p.className='karaoke-line'+(relative===0?' is-current':relative<0?' is-previous':' is-next');
  p.textContent=cue?.text||'';fragment.appendChild(p);
 }
 lyricContent.replaceChildren(fragment);
}
let activeBlobUrl = null;
let playbackRequest = 0;
let fallbackAttempted = false;
const clock = seconds => Number.isFinite(seconds) ? `${Math.floor(seconds/60)}:${String(Math.floor(seconds%60)).padStart(2,'0')}` : '0:00';
function select(i, autoplay = true) {
 index = (i + tracks.length) % tracks.length;
 const track = tracks[index];
 playbackRequest++;
 fallbackAttempted = false;
 if (activeBlobUrl) { URL.revokeObjectURL(activeBlobUrl); activeBlobUrl = null; }
 audio.src = track.src;
 title.textContent = track.title;
 loadLyrics(index);
 elapsed.textContent = '0:00';
 total.textContent = clock(track.duration);
 seek.value = '0';
 buttons.forEach((button,j) => {button.classList.toggle('is-active',j===index);button.setAttribute('aria-current',j===index?'true':'false');});
 status.textContent = '';
 if (autoplay) play();
 else toggle.textContent = '▶';
}
async function tryDirectDownloadFallback() {
 if (index !== 1 || fallbackAttempted) return false;
 fallbackAttempted = true;
 const request = playbackRequest;
 status.textContent = 'Trying an alternate audio loading method…';
 try {
  // Fetch without an audio element's Range header; reject HTML fallbacks.
  const response = await fetch('/audio/02-one-foot-home.mp3?download=1&v=20261020-fix1', {cache:'no-store'});
  if (!response.ok) throw new Error('HTTP ' + response.status);
  const type = response.headers.get('content-type') || '';
  if (type.includes('text/html')) throw new Error('Server returned HTML instead of audio');
  const blob = await response.blob();
  if (request !== playbackRequest || index !== 1) return true;
  if (blob.size < 100000 || (blob.type && blob.type.includes('text/html'))) throw new Error('Invalid audio response');
  activeBlobUrl = URL.createObjectURL(new Blob([blob], {type:'audio/mpeg'}));
  audio.src = activeBlobUrl;
  await audio.play();
  status.textContent = '';
  return true;
 } catch (error) {
  if (request === playbackRequest && index === 1) status.textContent = 'One Foot Home could not load: ' + error.message;
  return false;
 }
}
async function play(){
 const request = playbackRequest;
 try { await audio.play(); if(request !== playbackRequest)return; toggle.textContent='Ⅱ';toggle.setAttribute('aria-label','Pause');status.textContent=''; }
 catch(error){
  if(request !== playbackRequest)return;
  if (await tryDirectDownloadFallback()) return;
  if (!status.textContent || !status.textContent.startsWith('One Foot Home')) status.textContent='Playback failed: ' + (error?.message || 'Unknown browser error');
  toggle.textContent='▶';
 }
}
toggle.addEventListener('click',()=>{if(audio.paused)play();else audio.pause();});
audio.addEventListener('pause',()=>{toggle.textContent='▶';toggle.setAttribute('aria-label','Play');});
audio.addEventListener('play',()=>{toggle.textContent='Ⅱ';toggle.setAttribute('aria-label','Pause');});
audio.addEventListener('timeupdate',()=>{elapsed.textContent=clock(audio.currentTime);if(audio.duration)seek.value=String(Math.round(audio.currentTime/audio.duration*1000));syncLyrics();});
audio.addEventListener('loadedmetadata',()=>{total.textContent=clock(audio.duration);});
audio.addEventListener('ended',()=>select(index+1));
audio.addEventListener('error',()=>{if (index !== 1 || fallbackAttempted) status.textContent='Audio could not be decoded or delivered. Try again.';});
seek.addEventListener('input',()=>{if(audio.duration)audio.currentTime=Number(seek.value)/1000*audio.duration;});
volume.addEventListener('input',()=>audio.volume=Number(volume.value)/100);
prev.addEventListener('click',()=>select(index-1));
next.addEventListener('click',()=>select(index+1));
buttons.forEach((button,i)=>button.addEventListener('click',()=>select(i)));
audio.volume=.85;
select(0,false);
})();
</script>
<style is:global>
.music-player .karaoke{border:0!important;background:transparent!important;box-shadow:none!important;margin-top:1.5rem;padding:0!important}
.music-player .karaoke-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem}
.music-player .karaoke-top button{font-size:.75rem;padding:.35rem .7rem;border:1px solid rgba(176,141,87,.35);background:transparent;color:var(--muted);border-radius:.5rem}
.music-player .karaoke #lyrics-panel{border:0!important;background:transparent!important;padding:0!important}
.music-player .karaoke-stage{height:238px!important;min-height:238px!important;max-height:238px!important;overflow:hidden!important;border:0!important;background:transparent!important;box-shadow:none!important;padding:0!important;scrollbar-width:none!important;display:flex;align-items:center;justify-content:center}
.music-player .karaoke-stage::-webkit-scrollbar{display:none!important}
.music-player .karaoke-lines{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;transition:opacity .18s ease}
.music-player .karaoke-line{width:100%;height:33.333%;margin:0!important;padding:.2rem .75rem!important;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.3;font-family:Georgia,serif;font-size:clamp(1rem,2.1vw,1.55rem);color:rgba(243,239,230,.35);transition:color .2s ease,transform .2s ease;font-weight:400}
.music-player .karaoke-line.is-current{font-size:clamp(1.15rem,2.6vw,1.9rem);font-weight:700;color:#e9bc77;transform:scale(1.025)}
.music-player .karaoke-note{display:none!important}
@media(max-width:600px){.music-player .karaoke-stage{height:216px!important;min-height:216px!important;max-height:216px!important}.music-player .karaoke-line{font-size:1rem}.music-player .karaoke-line.is-current{font-size:1.2rem}}
@media(prefers-reduced-motion:reduce){.music-player .karaoke-line{transition:none!important}}
</style>
</BaseLayout>