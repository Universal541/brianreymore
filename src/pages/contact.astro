---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Correspondence | Brian Reymore"
  description="Thoughtful correspondence with Brian Reymore."
>
<header class="editorial-hero editorial-hero--contact"><div class="kicker">Correspondence</div><h1>Correspondence</h1><p>Thoughtful disagreement, serious questions, and good-faith dialogue are welcome.</p></header>

  <main class="essay-shell">
    <section class="essay-article">
      <header class="essay-header">
        <p class="eyebrow">Write to the publication</p>

        <h2>Reach Out</h2>

        <p class="essay-description">
          Thoughtful disagreement, serious questions, and good-faith dialogue
          are welcome.
        </p>
      </header>

      <div class="essay-content">
        <p>
          This site exists for serious inquiry, moral courage, and difficult
          conversations undertaken in good faith.
        </p>

        <p>
          If you are writing thoughtfully, I will do my best to respond.
        </p>
      </div>

      
      <form
        action="https://formspree.io/f/mdajdjnv"
        method="POST"
        class="contact-form"
      >
        <div class="field">
          <label for="name">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
          />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
          />
        </div>

        <div class="field">
          <label for="subject">Subject</label>
          <input
            type="text"
            id="subject"
            name="subject"
          />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            rows="8"
            required
          ></textarea>
        </div>

        <button type="submit" class="submit-button">
          Send Message
        </button>
      </form>
    </section>
<section id="submissions" aria-labelledby="submissions-heading" class="prose reading" style="margin:3rem auto">
<h2 id="submissions-heading">Bring Us Into Your World</h2>
<p>We welcome thoughtful essays, observations, links, civic concerns, moral questions, and stories worth examining. You do not need credentials; sincerity and care matter more.</p>
<p>Submissions do not guarantee publication, response, investigation, or follow-up. Material may be read privately; permission is required before public attribution.</p>
<form class="submission-form" action="https://formspree.io/f/xdajdvlz" method="POST">
<input type="hidden" name="_redirect" value="https://brianreymore.com/submission-received/" />
<input type="hidden" name="_subject" value="New BR.com Submission" />
<input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
<label>Name <span>(optional)</span><input type="text" name="name" /></label>
<label>Email <span>(optional)</span><input type="email" name="email" /></label>
<label>What are you sending?
<select name="submission_type" required>
<option value="">Choose one...</option>
<option>Essay</option><option>Observation</option><option>Local Issue</option><option>Civic Concern</option><option>Link / Resource</option><option>Story</option><option>Question</option><option>Something I Can’t Stop Thinking About</option><option>Other</option>
</select></label>
<label>Title / Subject<input type="text" name="title" required /></label>
<label>Your submission<textarea name="submission" rows="12" required placeholder="Write or paste your essay, concern, observation, question, or story..."></textarea></label>
<label>Links / sources <span>(optional)</span><textarea name="links" rows="5"></textarea></label>
<div class="checks">
<label><input type="checkbox" name="may_contact" value="yes" /> You may contact me about this submission.</label>
<label><input type="checkbox" name="anonymous_ok" value="yes" /> If referenced publicly, I prefer to remain anonymous.</label>
<label><input type="checkbox" name="may_quote_or_reference" value="yes" /> You may quote, reference, or build upon this submission in future work, with editorial discretion.</label>
</div>
<p class="notice">Submission does not create an obligation, partnership, confidentiality, representation, publication rights, or expectation of response. Editorial discretion is reserved.</p>
<button type="submit">Submit for Consideration</button>
</form>
</section>
  </main>
</BaseLayout>
